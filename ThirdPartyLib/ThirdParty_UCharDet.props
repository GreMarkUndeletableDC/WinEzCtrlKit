<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <ItemGroup>
        <_EckUCharDetCompile Include="$(MSBuildThisFileDirectory)UCharDet\*.cpp">
            <PrecompiledHeader>NotUsing</PrecompiledHeader>
            <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;_CRT_NONSTDC_NO_DEPRECATE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
        </_EckUCharDetCompile>
        <_EckUCharDetCompile Include="$(MSBuildThisFileDirectory)UCharDet\LangModels\*.cpp">
            <PrecompiledHeader>NotUsing</PrecompiledHeader>
            <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;_CRT_NONSTDC_NO_DEPRECATE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
        </_EckUCharDetCompile>
    </ItemGroup>

    <Target Name="EckAddUCharDetCompile"
            AfterTargets="BuildGenerateSources">
        <ItemGroup>
            <ClCompile Include="@(_EckUCharDetCompile)" />
        </ItemGroup>
    </Target>

</Project>
